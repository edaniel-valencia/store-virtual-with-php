# ============================================================
#  .htaccess - Tienda Virtual PHP
#  Front controller + hardening basico para produccion
# ============================================================

# ---- Bloqueo de carpetas internas (no deben servirse por HTTP) ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(Config|Controllers|Models|Librerias|Views|vendor)(/|$) - [F,L]
</IfModule>

# ---- Bloqueo de archivos sensibles ----
<FilesMatch "\.(sql|log|ini|lock|env|md|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>
<Files "composer.json">
    Require all denied
</Files>
<Files ".htaccess">
    Require all denied
</Files>
<Files "router.php">
    Require all denied
</Files>

# ---- Front controller: rutas amigables ----
<IfModule mod_rewrite.c>
    # Descomenta si el proyecto vive en un subdirectorio, ej: /shop/
    # RewriteBase /

    # Descomenta para forzar HTTPS (requiere certificado SSL activo)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ---- Sin listado de directorios ----
<IfModule mod_autoindex.c>
    Options -Indexes -MultiViews
</IfModule>

AddDefaultCharset UTF-8

# ---- Cabeceras de seguridad ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# ---- Compresion GZIP ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
</IfModule>

# ---- Cache del navegador para archivos estaticos ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---- Ajustes de PHP (solo aplica con mod_php; en PHP-FPM usa .user.ini) ----
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
    php_value memory_limit 256M
    php_value max_execution_time 60
    php_flag session.cookie_httponly On
</IfModule>
